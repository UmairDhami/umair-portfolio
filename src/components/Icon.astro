---
// Inline stroke icons. Usage: <Icon name="code" size={22} />
const { name, size = 22 } = Astro.props;
const paths = {
  code: '<path d="M8 9 5 12l3 3m8-6 3 3-3 3M14 5l-4 14" />',
  layout: '<rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M9 20V9" />',
  cart: '<circle cx="9" cy="20" r="1.6" /><circle cx="18" cy="20" r="1.6" /><path d="M3 4h2l2.3 12.2a1 1 0 0 0 1 .8h8.6a1 1 0 0 0 1-.8L21 8H6" />',
  plug: '<path d="M12 3v6m0 0 3-3m-3 3L9 6M6.5 10 3 13.5 6.5 17M17.5 10 21 13.5 17.5 17M9 21h6" />',
  gauge: '<path d="M12 20a8 8 0 1 0-8-8" /><path d="m12 12 4-3" />',
  shield: '<path d="M12 3 5 6v5c0 4.4 3 8.5 7 10 4-1.5 7-5.6 7-10V6l-7-3Z" /><path d="m9 12 2 2 4-4" />',
  arrow: '<path d="M7 17 17 7M17 7H9M17 7v8" />',
  brackets: '<path d="m8 9-3 3 3 3m8-6 3 3-3 3" />',
  bolt: '<path d="M13 3 4 14h7l-1 7 9-11h-7l1-7Z" />',
  check: '<path d="M20 6 9 17l-5-5" />',
};
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name] ?? ''}
/>
