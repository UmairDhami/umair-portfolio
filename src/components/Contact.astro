---
import Icon from './Icon.astro';
import { profile } from '../data/content.js';
---
<section class="wrap" id="contact">
  <div class="contact" data-reveal>
    <div class="contact-grid">
      <div class="contact-info">
        <span class="eyebrow">07 — Let's connect</span>
        <h2>Have a project in mind? <span class="grad">Let's make it happen.</span></h2>
        <p class="lead">Have a website idea, need a WordPress specialist, or want to improve an existing site? I'd love to hear what you're working on.</p>
        <div class="cinfo">
          <div><div class="k">Email</div><a class="v" href={`mailto:${profile.email}`}>{profile.email}</a></div>
          <div><div class="k">Phone</div><div class="v">{profile.phone}</div></div>
          <div><div class="k">Location</div><div class="v">{profile.location}</div></div>
        </div>
        <div class="socials">
          <a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.46 4.78 5.66V21H17.6v-5.3c0-1.26-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H9V9Z"/></svg>
            LinkedIn
          </a>
          <a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.98 1.03-2.68-.1-.26-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.39.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.85-2.34 4.7-4.57 4.95.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
            GitHub
          </a>
        </div>
      </div>

      <form class="contact-form" id="contact-form" novalidate>
        <div class="field">
          <label for="cf-name">Name</label>
          <input id="cf-name" name="name" type="text" required autocomplete="name" placeholder="Your name" />
        </div>
        <div class="field">
          <label for="cf-email">Email</label>
          <input id="cf-email" name="email" type="email" required autocomplete="email" placeholder="you@email.com" />
        </div>
        <div class="field">
          <label for="cf-msg">Message</label>
          <textarea id="cf-msg" name="message" rows="5" required placeholder="Tell me about your project…"></textarea>
        </div>
        <button type="submit" class="btn fill lg">Send message <Icon name="arrow" size={15} /></button>
        <p class="cf-status" id="cf-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>
