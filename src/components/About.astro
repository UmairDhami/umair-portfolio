---
import Icon from './Icon.astro';
---
<section class="wrap sec about" id="about">
  <div data-reveal>
    <span class="idx">01 — About me</span>
    <h2>Turning ideas into <span class="grad">powerful web solutions.</span></h2>
    <p class="lead">
      I'm a results-driven developer with professional experience building dynamic, responsive,
      performance-focused websites. Currently a Senior WordPress Developer at Core Growth, I work
      across development, theme and plugin customization, UI, and collaborative delivery — caring
      about the details from first layout to final optimization.
    </p>
    <div class="sig">
      <Icon name="check" size={18} />
      Design-mindful, development-driven.
    </div>
  </div>
  <div class="about-card" data-reveal>
    <div class="row"><span class="k">Role</span><span class="v">Senior WordPress Developer</span></div>
    <div class="row"><span class="k">Company</span><span class="v">Core Growth · 2023–Present</span></div>
    <div class="row"><span class="k">Based in</span><span class="v">Lahore, Pakistan</span></div>
    <div class="row"><span class="k">Focus</span><span class="v">Speed, UX, clean code</span></div>
    <div class="row"><span class="k">Availability</span><span class="v" style="color:var(--mint)">Open to new projects</span></div>
  </div>
</section>
