---
const { project } = Astro.props;
const { name, category, year, domain, url, thumb, full } = project;
const data = JSON.stringify({ name, domain, url, full });
---
<button class="wcard" data-reveal type="button" data-work={data} aria-label={`Preview the ${name} website`}>
  <div class="wthumb">
    <img src={thumb} alt={`${name} website homepage`} loading="lazy" width="820" height="512" />
    <span class="play"><span class="pill">View preview</span></span>
  </div>
  <div class="wfoot">
    <div>
      <b>{name}</b>
      <span class="cat">{category} · {year}</span>
    </div>
    <span class="go" aria-hidden="true">⤢</span>
  </div>
</button>
