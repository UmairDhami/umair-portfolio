---
import Icon from './Icon.astro';
---
<header class="wrap hero" id="top">
  <div>
    <span class="hero-eye"><span class="dot"></span>Available for freelance &amp; remote</span>
    <h1 data-hero-title>Modern sites, <span class="grad">engineered to convert.</span></h1>
    <p class="sub lead">
      I'm Umair — a WordPress &amp; web developer building fast, secure, beautifully-built
      websites for businesses worldwide. From the first layout to the final optimization.
    </p>
    <div class="cta">
      <a href="#work" class="btn fill lg">Explore my work <Icon name="arrow" size={15} /></a>
      <a href="#contact" class="btn ghost lg">Start a conversation</a>
    </div>
    <div class="meta">
      <div><b>9+</b><span>Websites shipped</span></div>
      <div><b>3+</b><span>Years building</span></div>
      <div><b>Lahore</b><span>Pakistan · remote</span></div>
    </div>
  </div>

  <div class="visual" style="position:relative" data-reveal>
    <div class="portrait">
      <!-- Drop your photo at /public/images/umair.jpg and swap the block below for:
           <img src="/images/umair.jpg" alt="Umair Saleem" /> -->
      <span class="demo">DEMO IMAGE</span>
      <span class="mk">US</span>
      <span class="cap">Your photo goes here</span>
    </div>
    <div class="badge one">
      <span class="ic"><Icon name="brackets" size={16} /></span>
      <span><b>Clean code</b><span>Built to last</span></span>
    </div>
    <div class="badge two">
      <span class="ic"><Icon name="bolt" size={16} /></span>
      <span><b>Fast &amp; secure</b><span>Speed + hardening</span></span>
    </div>
  </div>
</header>
